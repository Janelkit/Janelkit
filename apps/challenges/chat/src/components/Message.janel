<script lang="python">
from datetime import datetime

from janelkit import event, prop

msg = prop()
mine = prop(False)
base = prop("")  # http://host:puerto del servidor, para las imágenes
react = event()

EMOJIS = ["👍", "❤️", "😂"]


def hour(ts):
    return datetime.fromtimestamp(ts).strftime("%H:%M")
</script>

<row class="line">
  {#if mine}
    <spacer />
  {/if}
  <column class={"bubble mine" if mine else "bubble"}>
    {#if not mine}
      <text class="author">{msg["author"]}</text>
    {/if}
    <text format="markdown" class="body">{msg["text"]}</text>
    {#if msg.get("image")}
      <image src={base + msg["image"]} width={240} height={140} fit="cover" alt={msg["author"]} />
    {/if}
    <row class="meta">
      {#each list(msg["reactions"].items()) as r (r[0])}
        <text class="reaction">{r[0]} {r[1]}</text>
      {/each}
      <spacer />
      {#each EMOJIS as e (e)}
        <button variant="ghost" class="add" on:click={react.emit(msg["id"], e)} label={e}>{e}</button>
      {/each}
      <text class="time">{hour(msg["ts"])}</text>
    </row>
  </column>
</row>

<style>
.line { padding: 3px 12px; }
.bubble { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 8px 10px; gap: 4px; max-width: 460px; }
.mine { background: var(--surface-alt); border-color: var(--primary); }
.author { font-weight: 600; color: var(--primary); font-size: var(--font-size-sm); }
.meta { gap: 4px; align-items: center; }
.reaction { background: var(--surface-alt); border-radius: 8px; padding: 0 4px; font-size: var(--font-size-sm); }
.add { font-size: var(--font-size-sm); padding: 0 4px; }
.time { color: var(--text-muted); font-size: var(--font-size-sm); }
</style>
