<script lang="python">
# Inicio de la sección Personas: el directorio, con búsqueda. Abrir una apila su ficha.
from janelkit import computed, inject, state
from janelkit_router import navigation
from services.datos import cuenta
from vistas.Persona import Persona

datos = inject("datos")
nav = navigation()
buscar = state("")

# Tarjetas por persona, contadas una vez (y no fila a fila, cada una recorriendo todos los proyectos).
cuentas = computed(lambda: datos.cuentas())
visibles = computed(lambda: [
    p for p in datos.personas.value
    if not buscar.value.strip() or buscar.value.strip().lower() in (p["nombre"] + " " + p["correo"]).lower()
])


def nueva():
    nav.push(Persona, ident=datos.nueva_persona())
</script>

<flex class="pagina">
  <flex class="cabecera">
    <flex class="titulos">
      <text class="titulo">Personas</text>
      <text class="subtitulo">{f"{len(visibles)} de {len(datos.personas.value)}"}</text>
    </flex>
    <spacer />
    <textfield class="buscar" bind:value={buscar} placeholder="Buscar por nombre o correo…" label="Buscar personas" />
    <button text="+ Persona" variant="primary" on:click={nueva()} />
  </flex>
  <flex class="marco">
    <flex class="tabla">
      <flex class="encabezado">
        <text class="c-nombre">Nombre</text>
        <text class="c-correo">Correo</text>
        <text class="c-rol">Rol</text>
        <text class="c-tarjetas">Tarjetas</text>
      </flex>
      <list class="lista" label="Directorio">
        {#each visibles as p (p["id"])}
          <flex as="button" class="fila" label={p["nombre"]} on:click={nav.push(Persona, ident=p["id"])}>
            <flex class="c-nombre">
              <flex class="avatar" style={{"background": p["color"]}}><text>{datos.iniciales(p["id"])}</text></flex>
              <text class="nombre">{p["nombre"]}</text>
            </flex>
            <text class="c-correo correo">{p["correo"] or "—"}</text>
            <flex class="c-rol"><text class="rol">{p["rol"] or "Sin rol"}</text></flex>
            <text class="c-tarjetas dato">{cuenta(cuentas.get(p["id"], 0), "tarjeta")}</text>
          </flex>
        {/each}
      </list>
    </flex>
  </flex>
</flex>

<style>
.pagina { direction: column; flex: 1; }
.cabecera { gap: 12px; align-items: center; padding: 14px 24px; background: var(--surface); border-bottom: 1px solid var(--border); }
.titulos { direction: column; gap: 2px; }
.titulo { font-size: 20px; font-weight: 700; }
.subtitulo { color: var(--text-muted); font-size: 12px; }
.buscar { width: 300px; }
.marco { flex: 1; direction: column; padding: 20px 24px; }
.tabla { flex: 1; direction: column; background: var(--surface); border: 1px solid var(--border); border-radius: 10px; overflow: hidden; }
.encabezado {
  gap: 16px; padding: 10px 16px; background: var(--surface-alt); border-bottom: 1px solid var(--border);
  color: var(--text-muted); font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;
}
.lista { flex: 1; }
.fila:hover { background: var(--surface-alt); }
.fila:focus-visible { outline: 2px solid var(--primary); outline-offset: -2px; }
.fila { gap: 16px; align-items: center; padding: 8px 16px; cursor: pointer; border-bottom: 1px solid var(--border); }
.c-nombre { flex: 2; gap: 12px; align-items: center; }
.c-correo { flex: 2; }
.c-rol { flex: 1; }
.c-tarjetas { width: 100px; }
.avatar { width: 32px; height: 32px; border-radius: 16px; align-items: center; justify-content: center; color: #ffffff; font-size: 11px; font-weight: 600; }
.nombre { font-weight: 600; white-space: nowrap; text-overflow: ellipsis; }
.correo { color: var(--text-muted); white-space: nowrap; text-overflow: ellipsis; }
.rol { font-size: 12px; padding: 2px 8px; border-radius: 8px; background: var(--surface-alt); }
.dato { color: var(--text-muted); font-size: 12px; }
</style>
