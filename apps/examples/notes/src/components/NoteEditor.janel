<script lang="python">
from janelkit import prop, event, state, computed
from services.notes import TAGS, when

note = prop()
saved = event()
deleted = event()

# Borrador local del formulario. El padre recrea el editor al cambiar de nota
# ({#key}), así que basta con copiar la prop al crear el componente.
title = state(note.value["title"])
body = state(note.value["body"])
tag = state(note.value["tag"])


@computed
def dirty():
    n = note.value
    return (title.value, body.value, tag.value) != (n["title"], n["body"], n["tag"])


def save():
    saved.emit(note.value["id"], title=title.value.strip(), body=body.value, tag=tag.value)


def discard():
    title.value, body.value, tag.value = note.value["title"], note.value["body"], note.value["tag"]


def choose_tag(name):
    tag.value = name
</script>

<Column class="editor">
  <TextField class="title" bind:value={title} placeholder="Título" />
  <Row class="tags">
    {#each TAGS as name (name)}
      <Button variant={"primary" if name == tag else "default"} on:click={lambda: choose_tag(name)}>{name}</Button>
    {/each}
    <Spacer />
    <Text class="muted">Editada {when(note["updated"])}</Text>
  </Row>
  <Scroll class="body">
    <TextArea bind:value={body} placeholder="Escribe aquí…" />
  </Scroll>
  <Row class="actions">
    <Button variant="danger" on:click={lambda: deleted.emit(note["id"])}>Eliminar</Button>
    <Spacer />
    {#if dirty}
      <Text class="muted">Cambios sin guardar</Text>
      <Button variant="ghost" on:click={discard}>Descartar</Button>
    {/if}
    <Button variant="primary" on:click={save} enabled={dirty}>Guardar</Button>
  </Row>
</Column>

<style>
.editor { gap: 12px; flex: 1; }
.title { font-size: var(--font-size-xl); font-weight: 600; }
.tags, .actions { gap: 8px; align-items: center; }
.muted { color: var(--text-muted); font-size: var(--font-size-sm); }
</style>
