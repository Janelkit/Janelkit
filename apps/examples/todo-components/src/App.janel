<script lang="python">
from janelkit import state, computed
from components.TodoList import TodoList
from services import store

todos = state(store.initial())
draft = state("")
show_done = state(True)


@computed
def visible():
    return [t for t in todos.value if show_done.value or not t["done"]]


@computed
def summary():
    done = sum(t["done"] for t in todos.value)
    return f"{done} de {len(todos.value)} hechas"


def add():
    if draft.value.strip():
        todos.value = [*todos.value, store.new_todo(draft.value)]
        draft.value = ""


def on_toggled(todo_id, done):
    todos.value = store.update(todos.value, todo_id, done=done)


def on_renamed(todo_id, title):
    todos.value = store.update(todos.value, todo_id, title=title)


def on_removed(todo_id):
    todos.value = store.remove(todos.value, todo_id)
</script>

<window title="Tareas en componentes" width={560} height={520} minWidth={420}>
  <column class="page">
    <row class="header">
      <text class="title">Tareas</text>
      <spacer />
      <text class="muted">{summary}</text>
    </row>
    <row class="new">
      <textfield bind:value={draft} on:submit={add} placeholder="Nueva tarea" flex={1} />
      <button variant="primary" on:click={add}>Añadir</button>
    </row>
    <checkbox bind:checked={show_done}>Mostrar las hechas</checkbox>
    <TodoList
      todos={visible}
      empty_text={"Todo hecho." if todos else "Añade tu primera tarea."}
      on:toggled={on_toggled}
      on:renamed={on_renamed}
      on:removed={on_removed}
    />
  </column>
</window>

<style>
.page { padding: 24px; gap: 12px; }
.header { align-items: center; }
.title { font-size: var(--font-size-xl); font-weight: 600; }
.muted { color: var(--text-muted); }
.new { gap: 8px; }
</style>
