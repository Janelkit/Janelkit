<script lang="python">
# Preferencias que se recuerdan: cierra la aplicación, vuelve a abrirla y todo sigue igual.
from janelkit import effect, theme, untracked
from components.Notas import Notas
from services import prefs
# Para leerlos en la plantilla sin .value, por su nombre: se desenvuelven los nombres, no los
# atributos (prefs.letra es el state). bind: admite las dos formas.
from services.prefs import aperturas, letra, nombre

with untracked():
    aperturas.value += 1

effect(lambda: theme.set(prefs.tema.value))
carpeta = str(prefs.tema.file.parent)
</script>

<Window title="Preferencias" width={520} height={600}>
  <Column class="pagina">
    <Column class="cabecera">
      <Text class="titulo">{f"Hola, {nombre}" if nombre.strip() else "Hola"}</Text>
      <Text class="dato">{f"Has abierto esta aplicación {aperturas} {'vez' if aperturas == 1 else 'veces'}."}</Text>
    </Column>

    <Column class="bloque">
      <Text class="subtitulo">Preferencias</Text>
      <Row class="campo">
        <Text class="etiqueta">Nombre</Text>
        <TextField label="Nombre" bind:value={prefs.nombre} placeholder="¿Cómo te llamas?" flex={1} />
      </Row>
      <Row class="campo">
        <Text class="etiqueta">Tema</Text>
        <RadioGroup label="Tema" bind:value={prefs.tema} horizontal
                    options={[{"label": "Claro", "value": "light"}, {"label": "Oscuro", "value": "dark"}]} />
      </Row>
      <Row class="campo">
        <Text class="etiqueta">Tamaño de las notas</Text>
        <Slider label="Tamaño de las notas" bind:value={prefs.letra} min={11} max={22} step={1} flex={1} />
        <Text class="dato">{f"{letra:.0f} px"}</Text>
      </Row>
    </Column>

    <Column class="bloque" style={{"font-size": f"{letra:.0f}px"}}>
      <Text class="subtitulo">Notas rápidas</Text>
      <Notas />
    </Column>

    <Spacer />
    <Row class="pie">
      <Text class="ruta">{f"Guardado en {carpeta}"}</Text>
      <Button variant="ghost" on:click={prefs.restablecer()}>Restablecer</Button>
    </Row>
  </Column>
</Window>

<style>
.pagina { padding: 24px; gap: 18px; }
.cabecera { gap: 2px; }
.titulo { font-size: var(--font-size-xl); font-weight: 600; }
.subtitulo { font-weight: 600; }
.bloque { gap: 10px; padding: 16px; background: var(--surface); border: 1px solid var(--border); border-radius: 8px; }
.campo { gap: 12px; align-items: center; }
.etiqueta { width: 150px; }
.dato { color: var(--text-muted); font-size: 12px; }
.pie { gap: 8px; align-items: center; }
.ruta { flex: 1; color: var(--text-muted); font-size: 11px; white-space: nowrap; text-overflow: ellipsis; }
</style>
