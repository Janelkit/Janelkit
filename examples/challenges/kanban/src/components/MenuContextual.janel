<script lang="python">
# Menú contextual hecho con <flex> (como examples/flex/src/components/Menu.janel): toma
# el foco al abrirse, las flechas mueven la opción activa, Intro elige y Escape cierra.
# Un velo transparente sobre toda la ventana lo cierra con un clic fuera. Cada opción
# muestra su tecla: el reto pide que todo lo del menú se pueda hacer sin él.
from janelkit import event, on_mount, prop, ref, state

opciones = prop([])  # [{"label", "valor", "tecla"}]
x = prop(0)
y = prop(0)
elegir = event()
cerrar = event()
activa = state(0)
menu = ref()
on_mount(lambda: menu.focus())


def tecla(event):
    n = len(opciones.value)
    if event.key == "ArrowDown":
        activa.set((activa.value + 1) % n)
    elif event.key == "ArrowUp":
        activa.set((activa.value - 1) % n)
    elif event.key in ("Enter", " "):
        elegir.emit(opciones.value[activa.value]["valor"])
    elif event.key == "Escape":
        cerrar.emit()
    else:
        return
    event.prevent()
</script>

<flex class="velo" on:click={cerrar.emit()} on:contextmenu={cerrar.emit()}>
  <flex as="menu" class="menu" tabindex={0} label="Acciones de la tarjeta" ref={menu} on:keydown={tecla}
        style={{"left": f"{x}px", "top": f"{y}px"}} on:click={event.stop()}>
    {#each opciones as o, i (o["valor"])}
      <flex as="menuitem" class="opcion" selected={i == activa} label={o["label"]}
            on:pointerenter={activa = i} on:click={elegir.emit(o["valor"])}>
        <Text class="texto">{o["label"]}</Text>
        <Text class="tecla">{o["tecla"]}</Text>
      </flex>
    {/each}
  </flex>
</flex>

<style>
.velo { position: fixed; inset: 0; z-index: 100; cursor: default; }
/* Una caja con on:click se resalta sola al pasar el ratón: el velo y el menú lo usan
   solo para cerrar o para que el clic no siga, así que fijan su fondo con :hover. */
.velo:hover { background: transparent; }
.menu:hover { background: var(--surface); }
.menu {
  position: absolute; direction: column; padding: 4px; min-width: 220px;
  background: var(--surface); border: 1px solid var(--border); border-radius: 8px;
  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.18); outline: none; cursor: default;
}
.opcion { gap: 16px; padding: 6px 10px; border-radius: 5px; cursor: pointer; }
.opcion:selected { background: var(--surface-alt); }
.texto { flex: 1; }
.tecla { color: var(--text-muted); font-size: 12px; }
</style>
