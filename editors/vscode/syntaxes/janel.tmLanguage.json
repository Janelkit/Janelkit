{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "JanelKit",
  "scopeName": "source.janel",
  "fileTypes": ["janel"],
  "patterns": [
    { "include": "#comment" },
    { "include": "#script" },
    { "include": "#style" },
    { "include": "#block" },
    { "include": "#tag" },
    { "include": "#interpolation" }
  ],
  "repository": {
    "comment": {
      "name": "comment.block.html",
      "begin": "<!--",
      "end": "-->"
    },
    "script": {
      "begin": "(<)(script)\\b([^>]*)(>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.script.html" },
        "3": { "patterns": [{ "include": "#attribute" }] },
        "4": { "name": "punctuation.definition.tag.end.html" }
      },
      "end": "(</)(script)\\s*(>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.script.html" },
        "3": { "name": "punctuation.definition.tag.end.html" }
      },
      "contentName": "source.python.embedded.janel",
      "patterns": [{ "include": "source.python" }]
    },
    "style": {
      "begin": "(<)(style)\\b([^>]*)(>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.style.html" },
        "4": { "name": "punctuation.definition.tag.end.html" }
      },
      "end": "(</)(style)\\s*(>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.style.html" },
        "3": { "name": "punctuation.definition.tag.end.html" }
      },
      "contentName": "source.css.embedded.janel",
      "patterns": [{ "include": "source.css" }]
    },
    "block": {
      "comment": "{#if x}, {:else if y}, {:else}, {/if}, {#each xs as x, i (key)}, {#key k}",
      "begin": "(\\{)([#:/])(if|each|key|else(?:\\s+if)?)\\b",
      "beginCaptures": {
        "1": { "name": "punctuation.section.embedded.begin.janel" },
        "2": { "name": "keyword.control.janel" },
        "3": { "name": "keyword.control.janel" }
      },
      "end": "\\}",
      "endCaptures": { "0": { "name": "punctuation.section.embedded.end.janel" } },
      "contentName": "meta.embedded.expression.janel",
      "patterns": [
        { "match": "\\bas\\b", "name": "keyword.control.janel" },
        { "include": "#braces" },
        { "include": "source.python" }
      ]
    },
    "interpolation": {
      "begin": "\\{",
      "beginCaptures": { "0": { "name": "punctuation.section.embedded.begin.janel" } },
      "end": "\\}",
      "endCaptures": { "0": { "name": "punctuation.section.embedded.end.janel" } },
      "contentName": "meta.embedded.expression.janel",
      "patterns": [{ "include": "#braces" }, { "include": "source.python" }]
    },
    "braces": {
      "comment": "Llaves anidadas dentro de una expresión (diccionarios, conjuntos)",
      "begin": "\\{",
      "end": "\\}",
      "patterns": [{ "include": "#braces" }, { "include": "source.python" }]
    },
    "tag": {
      "begin": "(</?)([A-Za-z][\\w.]*)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.janel" }
      },
      "end": "(/?>)",
      "endCaptures": { "1": { "name": "punctuation.definition.tag.end.html" } },
      "patterns": [{ "include": "#attribute" }]
    },
    "attribute": {
      "patterns": [
        {
          "match": "\\b(on|bind|class)(:)([\\w-]+)",
          "captures": {
            "1": { "name": "keyword.other.directive.janel" },
            "2": { "name": "punctuation.separator.key-value.janel" },
            "3": { "name": "entity.other.attribute-name.janel" }
          }
        },
        { "match": "\\b[A-Za-z_][\\w.-]*", "name": "entity.other.attribute-name.html" },
        { "match": "=", "name": "punctuation.separator.key-value.html" },
        { "begin": "\"", "end": "\"", "name": "string.quoted.double.html" },
        { "begin": "'", "end": "'", "name": "string.quoted.single.html" },
        { "include": "#interpolation" }
      ]
    }
  }
}
