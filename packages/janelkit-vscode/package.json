{
  "name": "janelkit-janel",
  "displayName": "JanelKit (.janel)",
  "description": "Resaltado de sintaxis para componentes .janel de JanelKit: Python en <script> y {expresiones}, CSS en <style>.",
  "version": "0.0.1",
  "publisher": "janelkit",
  "license": "UNLICENSED",
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [
      {
        "id": "janel",
        "aliases": ["JanelKit", "janel"],
        "extensions": [".janel"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "janel",
        "scopeName": "source.janel",
        "path": "./syntaxes/janel.tmLanguage.json",
        "embeddedLanguages": {
          "source.python.embedded.janel": "python",
          "meta.embedded.expression.janel": "python",
          "source.css.embedded.janel": "css"
        }
      }
    ]
  }
}
