<script lang="python">
# Una fila de la hoja: su número y las columnas visibles (vista.visibles). Cada celda es
# un solo <Text> (las líneas de la rejilla son el hueco de 1 px entre celdas) y los
# eventos de puntero los recibe la fila, que calcula la columna con event.x: así una
# celda cuesta lo mínimo. Arrastrar con el botón pulsado extiende la selección.
from janelkit import computed, inject, prop
from components.Editor import Editor
from services.vista import ANCHO_COL, ANCHO_NUM

f = prop(0)
hoja = inject("hoja")
vista = inject("vista")
enfocar = inject("enfocar")  # devuelve el foco a la rejilla
cols = vista.visibles


# Lo que cada celda necesita saber de la selección, calculado una vez por fila. Al mover
# el cursor solo cambia en las filas afectadas, y las celdas de las demás no se reevalúan.
@computed
def sel():
    r0, c0, r1, c1 = vista.rango.value
    return (c0, c1) if r0 <= f.value <= r1 else None


@computed
def cur():
    r, c = vista.cursor.value
    return c if r == f.value else None


@computed
def editando():
    e = vista.editando.value
    return e[1] if e is not None and e[0] == f.value else None


def columna(event):
    i = int((event.x - ANCHO_NUM) // ANCHO_COL)
    visibles = cols.peek()
    return visibles[i] if 0 <= i < len(visibles) and event.x >= ANCHO_NUM else None


def pulsar(event):
    c = columna(event)
    if c is not None and event.button == "left":
        vista.ir(f.value, c, extender=event.shift)
        enfocar()


def arrastrar(event):
    c = columna(event)
    if c is not None and "left" in event.buttons and vista.cursor.peek() != (f.value, c):
        vista.ir(f.value, c, extender=True)


def es_numero(c):
    return isinstance(hoja.valor(f.value, c), float)
</script>

<flex class="fila" on:pointerdown={pulsar} on:pointermove={arrastrar} on:dblclick={columna(event) is not None and vista.empezar()}>
  <Text class="num" class:activa={sel is not None}>{f + 1}</Text>
  {#each cols as c (c)}
    <Text class="celda" class:sel={sel is not None and sel[0] <= c <= sel[1]} class:cursor={cur == c}
          class:numero={es_numero(c)} class:fija={c == 0 and vista.congelar_col.value}>{hoja.texto(f, c)}</Text>
  {/each}
  {#if editando is not None}
    <Editor x={vista.x_de(editando)} />
  {/if}
</flex>

<style>
.fila { height: 25px; gap: 1px; padding-bottom: 1px; background: var(--border); position: relative; }
.num { width: 55px; padding: 3px 6px; text-align: right; background: var(--surface); color: var(--text-muted); font-size: 12px; }
.num.activa { background: var(--surface-alt); color: var(--text); }
.celda { width: 95px; padding: 3px 4px; background: var(--bg); font-size: 13px; white-space: nowrap; text-overflow: ellipsis; }
.celda.numero { text-align: right; }
.celda.fija { background: var(--surface); }
.celda.sel { background: var(--surface-alt); }
.celda.cursor { border: 2px solid var(--primary); padding: 1px 2px; }
</style>
