<script lang="python">
from janelkit import prop, event
from components.TodoItem import TodoItem

todos = prop()
empty_text = prop("No hay tareas.")

# La lista no modifica los datos: reenvía los eventos de cada fila al padre.
toggled = event()
renamed = event()
removed = event()
</script>

<Scroll class="list">
  {#each todos as todo (todo["id"])}
    <TodoItem
      todo={todo}
      on:toggled={toggled.emit}
      on:renamed={renamed.emit}
      on:removed={removed.emit}
    />
  {:else}
    <Text class="empty">{empty_text}</Text>
  {/each}
</Scroll>

<style>
.list { padding: 6px; gap: 4px; background: var(--surface-alt); border-radius: var(--radius); }
.empty { padding: 24px; color: var(--text-muted); text-align: center; }
</style>
