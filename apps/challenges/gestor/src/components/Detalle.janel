<script lang="python">
# Panel de detalle de una tarjeta. Edita un borrador; «Guardar» (o Ctrl+Intro) lo
# aplica como un solo cambio que se puede deshacer. Escape cierra sin guardar.
# Salir del proyecto (o cerrar la ventana) con cambios sin guardar pregunta antes.
from janelkit import before_leave, event, inject, on_mount, prop, ref, state
from janelkit_desktop import dialogs
from janelkit_store import use
from services.datos import Datos

ident = prop("")
cerrar = event()
tablero = inject("tablero")
datos = use(Datos)
t = tablero.tarjeta(ident.value)
ETIQUETAS = tablero.etiquetas
titulo = state(t["titulo"])
descripcion = state(t["descripcion"])
responsable = state(t["responsable"])
fecha = state(t["fecha"])
etiquetas = state(list(t["etiquetas"]))
campo = ref()
on_mount(lambda: campo.focus())
PERSONAS_OPC = [{"label": "Sin responsable", "value": ""}] + [
    {"label": datos.nombre(m["persona"]), "value": m["persona"]} for m in tablero.proyecto["miembros"]]


def borrador():
    return {"titulo": titulo.value.strip() or t["titulo"], "descripcion": descripcion.value, "responsable": responsable.value,
            "fecha": fecha.value.strip(), "etiquetas": [e for e in ETIQUETAS if e in etiquetas.value]}


@before_leave
async def salir():
    if all(t[k] == v for k, v in borrador().items()):
        return True
    return await dialogs.confirm(f"«{t['titulo']}» tiene cambios sin guardar. ¿Salir sin guardarlos?")


def marcar(e, si):
    if si and e not in etiquetas.value:
        etiquetas.value.append(e)
    elif not si and e in etiquetas.value:
        etiquetas.value.remove(e)


def guardar():
    tablero.editar(ident.value, **borrador())
    cerrar.emit()


def tecla(event):
    if event.key == "Escape":
        cerrar.emit()
    elif event.key == "Enter" and event.ctrl:
        guardar()
    else:
        return
    event.prevent()
</script>

<flex as="dialog" class="detalle" label="Detalle de la tarjeta" on:keydown={tecla}>
  <text class="titulo-panel">Tarjeta</text>
  <text class="rotulo">Título</text>
  <textfield ref={campo} bind:value={titulo} label="Título" />
  <text class="rotulo">Descripción</text>
  <textarea class="descripcion" bind:value={descripcion} label="Descripción" />
  <text class="rotulo">Responsable</text>
  <select options={PERSONAS_OPC} bind:value={responsable} label="Responsable" />
  <text class="rotulo">Fecha (AAAA-MM-DD)</text>
  <textfield bind:value={fecha} placeholder="2026-11-03" label="Fecha" />
  <text class="rotulo">Etiquetas</text>
  <flex class="etiquetas">
    {#each list(ETIQUETAS) as e (e)}
      <checkbox text={e} checked={e in etiquetas} on:change={marcar(e, event)} />
    {/each}
  </flex>
  <flex class="botones">
    <button text="Cerrar" on:click={cerrar.emit()} />
    <button text="Guardar" variant="primary" on:click={guardar()} />
  </flex>
</flex>

<style>
.detalle {
  direction: column; width: 320px; gap: 6px; padding: 14px;
  background: var(--surface); border-left: 1px solid var(--border);
}
.titulo-panel { font-size: 16px; font-weight: 700; }
.rotulo { color: var(--text-muted); font-size: 12px; margin-top: 4px; }
.descripcion { height: 110px; }
.etiquetas { flex-wrap: wrap; gap: 8px; }
.botones { gap: 8px; justify-content: end; margin-top: 10px; }
</style>
