<script lang="python">
from fluxui import state, computed
from services.users import display_name

count = state(0)
name = state("")

@computed
def greeting():
    return f"Hola, {display_name(name.value)}"

def increment():
    count.value += 1

def reset():
    count.value = 0
</script>

<Window title="{{project_name}}" width={480} height={320}>
  <Column class="page">
    <Text class="title">{greeting}</Text>
    <TextField bind:value={name} placeholder="Escribe tu nombre" width={280} />
    <Row class="actions">
      <Button on:click={increment}>Clicks: {count}</Button>
      <Button on:click={reset} enabled={count > 0} flat>Reiniciar</Button>
    </Row>
    {#if count >= 5}
      <Text class="note">¡Llegaste a cinco clicks!</Text>
    {/if}
  </Column>
</Window>

<style>
.page { padding: 32px; gap: 16px; }
.title { font-size: 26px; font-weight: 600; }
.actions { gap: 8px; }
.note { color: #2e7d32; }
</style>
