{
  "name": "janelkit-janel",
  "displayName": "JanelKit (.janel)",
  "description": "Componentes .janel de JanelKit: resaltado de sintaxis (Python en <script> y {expresiones}, CSS en <style>) y los errores del compilador mientras escribes.",
  "version": "0.2.0",
  "publisher": "janelkit",
  "license": "MIT",
  "author": {
    "name": "d4ndres",
    "email": "d4ndres@gmail.com"
  },
  "homepage": "https://github.com/janelkit/janelkit/tree/main/packages/janelkit-vscode#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/janelkit/janelkit.git",
    "directory": "packages/janelkit-vscode"
  },
  "bugs": {
    "url": "https://github.com/janelkit/janelkit/issues"
  },
  "keywords": [
    "janelkit",
    "janel",
    "python",
    "qt",
    "pyside6",
    "syntax"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:janel"
  ],
  "contributes": {
    "languages": [
      {
        "id": "janel",
        "aliases": [
          "JanelKit",
          "janel"
        ],
        "extensions": [
          ".janel"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "janel",
        "scopeName": "source.janel",
        "path": "./syntaxes/janel.tmLanguage.json",
        "embeddedLanguages": {
          "source.python.embedded.janel": "python",
          "meta.embedded.expression.janel": "python",
          "source.css.embedded.janel": "css"
        }
      }
    ],
    "configuration": {
      "title": "JanelKit",
      "properties": {
        "janelkit.diagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Muestra los errores y avisos del compilador en los .janel mientras escribes (necesita janelkit 0.2.1 o posterior en el entorno de Python del proyecto)."
        },
        "janelkit.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Intérprete de Python que tiene janelkit instalado. Vacío: el de .venv o venv en la carpeta del proyecto; si no hay, el de la extensión de Python; si no, python."
        }
      }
    },
    "commands": [
      {
        "command": "janelkit.restartServer",
        "title": "JanelKit: reiniciar la comprobación de errores"
      }
    ]
  }
}
