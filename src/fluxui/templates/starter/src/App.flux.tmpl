<script lang="python">
from fluxui import state, computed, theme
from services.users import display_name
from components.Counter import Counter

name = state("")
message = state("")


@computed
def greeting():
    return f"Hola, {display_name(name.value)}"


def on_reached(total):
    message.value = f"Llegaste a {total} clicks."
</script>

<Window title="{{project_name}}" width={520} height={340}>
  <Column class="page">
    <Row class="header">
      <Text class="title">{greeting}</Text>
      <Spacer />
      <Button variant="ghost" on:click={theme.toggle()}>{"Tema oscuro" if theme.name == "light" else "Tema claro"}</Button>
    </Row>
    <TextField bind:value={name} placeholder="Escribe tu nombre" />
    <Counter goal={5} on:reached={on_reached} />
    {#if message}
      <Text class="note">{message}</Text>
    {/if}
  </Column>
</Window>

<style>
.page { padding: 32px; gap: 16px; }
.header { align-items: center; }
.title { font-size: var(--font-size-xl); font-weight: 600; }
.note { color: var(--success); }
</style>
