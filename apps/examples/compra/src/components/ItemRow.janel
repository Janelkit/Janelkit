<script lang="python">
from janelkit import prop, event

item = prop()
toggled = event()
removed = event()
</script>

<row class="row">
  <checkbox checked={item["done"]} on:change={toggled.emit(event)} flex={1}>{item["name"]}</checkbox>
  <button variant="ghost" on:click={removed.emit()}>Quitar</button>
</row>

<style>
.row { gap: 8px; align-items: center; }
</style>
