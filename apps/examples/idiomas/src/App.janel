<script lang="python">
# Cambio de idioma en caliente, plurales, formatos según el idioma y escritura de derecha a izquierda.
from datetime import date
from pathlib import Path

from janelkit import state
from janelkit_i18n import i18n, t

i18n.load(Path(__file__).parent / "locales")  # es.json, en.json, ar.json
i18n.set("es")

LANGUAGES = [{"label": "Español", "value": "es"}, {"label": "English", "value": "en"}, {"label": "العربية", "value": "ar"}]

language = state("es")
name = state("")
count = state(2)


def change_language(code):
    language.value = code
    i18n.set(code)
</script>

<window title="Idiomas" width={460} height={360}>
  <column class="page">
    <row class="top">
      <text class="title">{t("title")}</text>
      <spacer />
      <text class="muted">{t("language")}</text>
      <select value={language} options={LANGUAGES} on:change={change_language} />
    </row>

    <textfield bind:value={name} placeholder={t("name")} />
    <text class="big">{t("hello", name=name) if name else t("nobody")}</text>

    <row class="counter">
      <button on:click={count -= 1} enabled={count > 0}>{t("remove")}</button>
      <button variant="primary" on:click={count += 1}>{t("add")}</button>
      <text>{t("files", n=count)}</text>
    </row>

    <text>{t("total", amount=i18n.currency(1234.5 * count, "€"))}</text>
    <text class="muted">{t("today", date=i18n.date(date.today(), "long"))}</text>
  </column>
</window>

<style>
.page { padding: 24px; gap: 14px; }
.top, .counter { gap: 8px; align-items: center; }
.title { font-size: var(--font-size-xl); font-weight: 600; }
.big { font-size: var(--font-size-lg); }
.muted { color: var(--text-muted); }
</style>
